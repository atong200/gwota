{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leader.schema.json",
  "title": "Gwota leader",
  "description": "One leader per file: data/leaders/<id>.json. Art: assets/leaders/<id>.png.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "faction", "ability", "abilityName"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "faction": { "enum": ["realms", "abyss", "horde"] },
    "ability": {
      "description": "Used once per match instead of playing a card.",
      "enum": ["clear_weather", "play_weather_from_deck", "horn_row", "scorch_row", "return_from_discard", "scorch", "return_from_board"]
    },
    "row": {
      "description": "Required by horn_row, scorch_row and play_weather_from_deck.",
      "enum": ["melee", "ranged", "siege"]
    },
    "abilityName": {
      "description": "Display name of the ability, e.g. \"Illuminate\". The rules text is generated from 'ability' and 'row'.",
      "type": "string",
      "minLength": 1
    }
  },
  "if": { "properties": { "ability": { "enum": ["horn_row", "scorch_row", "play_weather_from_deck"] } } },
  "then": { "required": ["row"] },
  "else": { "not": { "required": ["row"] } }
}
